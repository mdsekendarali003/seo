---
/**
 * FAQ rendering. Uses native <details> so answers are in the DOM at load —
 * content hidden behind JavaScript accordions is frequently not extracted by
 * AI retrievers, which is why this deliberately avoids a JS-driven widget.
 * `open` on the first two gives a visible answer above the fold.
 */
const { faqs, heading = 'Frequently asked questions', id = 'faq' } = Astro.props;
---
<section class="faq" id={id} aria-labelledby={`${id}-h`}>
  <h2 id={`${id}-h`}>{heading}</h2>
  <div class="faq-list">
    {faqs.map((f, i) => (
      <details open={i < 2}>
        <summary><h3>{f.q}</h3></summary>
        <div class="faq-answer" data-speakable><p>{f.a}</p></div>
      </details>
    ))}
  </div>
</section>
